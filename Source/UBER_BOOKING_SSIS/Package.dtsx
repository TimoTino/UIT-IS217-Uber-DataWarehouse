          DTS:ObjectName="CREATE ALL TABLES"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{DC098981-A908-44E7-B505-E5CAB85BAD49}"
              SQLTask:SqlStatementSource="USE UBER_BOOKING_SSIS;&#xA;GO&#xA;&#xA;CREATE TABLE DIM_BOOKING_STATUS (&#xA;    STATUS_KEY INT IDENTITY(1,1) PRIMARY KEY,&#xA;    GROUP_KEY INT,&#xA;    BOOKING_STATUS NVARCHAR(50),&#xA;    REASON_DESCRIPTION NVARCHAR(50),&#xA;    CANCELLED_BY NVARCHAR(8)&#xA;);&#xA;&#xA;CREATE TABLE DIM_CUSTOMER (&#xA;    CUSTOMER_KEY INT IDENTITY(1,1) PRIMARY KEY,&#xA;    CUSTOMER_ID VARCHAR(50)&#xA;);&#xA;&#xA;CREATE TABLE DIM_DATE (&#xA;    DATE_KEY INT IDENTITY(1,1) PRIMARY KEY,&#xA;    FULL_DATE DATE,&#xA;    YEAR INT,&#xA;    MONTH INT,&#xA;    DAY INT,&#xA;    DAY_OF_WEEK INT,&#xA;    QUARTER INT&#xA;);&#xA;&#xA;CREATE TABLE DIM_LOCATION (&#xA;    LOCATION_KEY INT IDENTITY(1,1) PRIMARY KEY,&#xA;    LOCATION_NAME VARCHAR(250),&#xA;    CITY VARCHAR(50),&#xA;    DISTRICT VARCHAR(50)&#xA;);&#xA;&#xA;CREATE TABLE DIM_PAYMENT (&#xA;    PAYMENT_KEY INT IDENTITY(1,1) PRIMARY KEY,&#xA;    PAYMENT_METHOD NVARCHAR(50)&#xA;);&#xA;&#xA;CREATE TABLE DIM_TIME (&#xA;    TIME_KEY INT IDENTITY(1,1) PRIMARY KEY,&#xA;    TIME VARCHAR(50),&#xA;    HOUR INT,&#xA;    MINUTE INT,&#xA;    SECOND INT,&#xA;    TIME_PERIOD NVARCHAR(9)&#xA;);&#xA;&#xA;CREATE TABLE DIM_VEHICLE (&#xA;    VEHICLE_KEY INT IDENTITY(1,1) PRIMARY KEY,&#xA;    VEHICLE_TYPE NVARCHAR(50)&#xA;);&#xA;&#xA;CREATE TABLE DIM_STATUS_GROUP (&#xA;    GROUP_KEY INT IDENTITY(1,1) PRIMARY KEY,&#xA;    GROUP_NAME NVARCHAR(50)&#xA;);&#xA;&#xA;CREATE TABLE FACT_RIDE_BOOKING (&#xA;    BOOKING_KEY INT IDENTITY(1,1) PRIMARY KEY,&#xA;&#xA;    BOOKING_ID VARCHAR(50),&#xA;&#xA;    BOOKING_VALUE DECIMAL(18,2),&#xA;    RIDE_DISTANCE DECIMAL(10,2),&#xA;    VTAT DECIMAL(10,2),&#xA;    CTAT DECIMAL(10,2),&#xA;&#xA;    CUSTOMER_RATING DECIMAL(3,2),&#xA;    DRIVER_RATING DECIMAL(3,2),&#xA;&#xA;    IS_CUSTOMER_CANCEL INT,&#xA;    IS_DRIVER_CANCEL INT,&#xA;    IS_INCOMPLETE INT,&#xA;&#xA;    DATE_KEY INT,&#xA;    TIME_KEY INT,&#xA;    CUSTOMER_KEY INT,&#xA;    VEHICLE_KEY INT,&#xA;    PICKUP_LOCATION_KEY INT,&#xA;    DROP_LOCATION_KEY INT,&#xA;    STATUS_KEY INT,&#xA;    PAYMENT_KEY INT,&#xA;&#xA;    CONSTRAINT FK_FACT_DATE FOREIGN KEY (DATE_KEY) REFERENCES DIM_DATE(DATE_KEY),&#xA;    CONSTRAINT FK_FACT_TIME FOREIGN KEY (TIME_KEY) REFERENCES DIM_TIME(TIME_KEY),&#xA;    CONSTRAINT FK_FACT_CUSTOMER FOREIGN KEY (CUSTOMER_KEY) REFERENCES DIM_CUSTOMER(CUSTOMER_KEY),&#xA;    CONSTRAINT FK_FACT_VEHICLE FOREIGN KEY (VEHICLE_KEY) REFERENCES DIM_VEHICLE(VEHICLE_KEY),&#xA;    CONSTRAINT FK_FACT_PICKUP_LOC FOREIGN KEY (PICKUP_LOCATION_KEY) REFERENCES DIM_LOCATION(LOCATION_KEY),&#xA;    CONSTRAINT FK_FACT_DROP_LOC FOREIGN KEY (DROP_LOCATION_KEY) REFERENCES DIM_LOCATION(LOCATION_KEY),&#xA;    CONSTRAINT FK_FACT_STATUS FOREIGN KEY (STATUS_KEY) REFERENCES DIM_BOOKING_STATUS(STATUS_KEY),&#xA;    CONSTRAINT FK_FACT_PAYMENT FOREIGN KEY (PAYMENT_KEY) REFERENCES DIM_PAYMENT(PAYMENT_KEY)&#xA;);&#xA;&#xA;CREATE UNIQUE INDEX IX_DIM_CUSTOMER_ID ON DIM_CUSTOMER(CUSTOMER_ID);&#xA;CREATE INDEX IX_DIM_LOCATION_NAME ON DIM_LOCATION(LOCATION_NAME);&#xA;CREATE INDEX IX_DIM_PAYMENT_METHOD ON DIM_PAYMENT(PAYMENT_METHOD);&#xA;CREATE INDEX IX_DIM_VEHICLE_TYPE ON DIM_VEHICLE(VEHICLE_TYPE);&#xA;CREATE INDEX IX_DIM_STATUS_GROUP_NAME ON DIM_STATUS_GROUP(GROUP_NAME);&#xA;CREATE INDEX IX_DIM_BOOKING_STATUS ON DIM_BOOKING_STATUS(BOOKING_STATUS);&#xA;CREATE UNIQUE INDEX IX_DIM_DATE_FULL_DATE ON DIM_DATE(FULL_DATE);&#xA;CREATE INDEX IX_DIM_TIME_TIME ON DIM_TIME(TIME);&#xA;&#xA;CREATE INDEX IX_FACT_CUSTOMER_KEY ON FACT_RIDE_BOOKING(CUSTOMER_KEY);&#xA;CREATE INDEX IX_FACT_DATE_KEY ON FACT_RIDE_BOOKING(DATE_KEY);&#xA;CREATE INDEX IX_FACT_TIME_KEY ON FACT_RIDE_BOOKING(TIME_KEY);&#xA;CREATE INDEX IX_FACT_VEHICLE_KEY ON FACT_RIDE_BOOKING(VEHICLE_KEY);&#xA;CREATE INDEX IX_FACT_PICKUP_LOC_KEY ON FACT_RIDE_BOOKING(PICKUP_LOCATION_KEY);&#xA;CREATE INDEX IX_FACT_DROP_LOC_KEY ON FACT_RIDE_BOOKING(DROP_LOCATION_KEY);&#xA;CREATE INDEX IX_FACT_STATUS_KEY ON FACT_RIDE_BOOKING(STATUS_KEY);&#xA;CREATE INDEX IX_FACT_PAYMENT_KEY ON FACT_RIDE_BOOKING(PAYMENT_KEY);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
