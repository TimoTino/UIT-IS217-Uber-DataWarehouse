          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{DC098981-A908-44E7-B505-E5CAB85BAD49}"
              SQLTask:SqlStatementSource="USE UBER_BOOKING_SSIS;&#xA;GO&#xA;&#xA;DROP TABLE IF EXISTS FACT_RIDE_BOOKING;&#xA;DROP TABLE IF EXISTS DIM_BOOKING_STATUS;&#xA;DROP TABLE IF EXISTS DIM_STATUS_GROUP;&#xA;DROP TABLE IF EXISTS DIM_CUSTOMER;&#xA;DROP TABLE IF EXISTS DIM_DATE;&#xA;DROP TABLE IF EXISTS DIM_LOCATION;&#xA;DROP TABLE IF EXISTS DIM_PAYMENT;&#xA;DROP TABLE IF EXISTS DIM_TIME;&#xA;DROP TABLE IF EXISTS DIM_VEHICLE;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
